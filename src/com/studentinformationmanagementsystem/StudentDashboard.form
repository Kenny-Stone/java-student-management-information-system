<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.studentinformationmanagementsystem.StudentDashboard">
  <grid id="27dc6" binding="studentDashboardPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="1298" height="853"/>
    </constraints>
    <properties>
      <background color="-8355712"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="f0474" binding="header" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-14071847"/>
          <font size="20"/>
          <preferredSize width="238" height="50"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="b3f47" class="javax.swing.JLabel" binding="logo">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="1" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="20"/>
              <text value="logo"/>
            </properties>
          </component>
          <component id="4325f" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="1" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="20"/>
              <text value="Student Dashboard"/>
            </properties>
          </component>
          <component id="eed9f" class="javax.swing.JLabel" binding="studentDetailsLink">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="3" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Monaco" size="14"/>
              <text value="Name"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="3c2bf" binding="stuImageAndWelcomePanel" layout-manager="BorderLayout" hgap="0" vgap="50">
        <constraints border-constraint="West"/>
        <properties>
          <foreground color="-1907989"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="fc03a" class="javax.swing.JLabel" binding="studentImage">
            <constraints border-constraint="West"/>
            <properties>
              <text value="studentImage"/>
            </properties>
          </component>
          <component id="fb5a9" class="javax.swing.JLabel">
            <constraints border-constraint="East"/>
            <properties>
              <font size="20"/>
              <text value="Welcome, studentName"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
