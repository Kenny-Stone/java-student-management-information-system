<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.studentinformationmanagementsystem.StudentDashboard">
  <grid id="27dc6" binding="studentDashboardPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="1298" height="853"/>
    </constraints>
    <properties>
      <background color="-8355712"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="f0474" binding="header" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-14071847"/>
          <font size="20"/>
          <preferredSize width="238" height="50"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="b3f47" class="javax.swing.JLabel" binding="schoolLogo">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="4" use-parent-layout="false">
                <preferred-size width="200" height="-1"/>
              </grid>
            </constraints>
            <properties>
              <font size="20"/>
              <text value=""/>
            </properties>
          </component>
          <component id="4325f" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="1" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="20"/>
              <foreground color="-3026727"/>
              <text value="Student Dashboard"/>
            </properties>
          </component>
          <component id="eed9f" class="javax.swing.JLabel" binding="studentDetailsLink">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="3" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="Monaco" size="14"/>
              <text value="Name"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="13b61" binding="main" layout-manager="GridLayoutManager" row-count="3" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="100">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="64d38" class="javax.swing.JLabel" binding="welcomeMessage">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="3" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font size="16"/>
              <text value="Welcome, Kenny Stone!"/>
            </properties>
          </component>
          <hspacer id="1c4a0">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <hspacer id="3eb92">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
          </hspacer>
          <grid id="89bc4" binding="coursesPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="3" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="1" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
          <grid id="7eb25" binding="schoolInfoPanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="5" bottom="0" right="5"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="3" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-3026727"/>
            </properties>
            <border type="none"/>
            <children>
              <grid id="d6e6" binding="contentPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children/>
              </grid>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
